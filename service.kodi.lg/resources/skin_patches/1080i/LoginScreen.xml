<?xml version="1.0" encoding="utf-8"?>
<!-- BINGIE -->
<window>
    <defaultcontrol always="true">52</defaultcontrol>

    <controls>
        <control type="group">
            <include>animation_window_open_close</include>
            <include>GlobalBackground</include>
            <include>NowPlayingBackground</include>
            <include>Header</include>

            <control type="image">
                <left>0</left>
                <top>0</top>
                <width>1920</width>
                <height>1080</height>
                <texture colordiffuse="D9000000">colors/color_white.png</texture>
            </control>

            <control type="label" id="2">
                <visible>false</visible>
            </control>

            <control type="label">
                <top>148</top>
                <width>1920</width>
                <height>86</height>
                <align>center</align>
                <aligny>center</aligny>
                <font>Reg46</font>
                <textcolor>$INFO[Skin.String(HeaderTextColor)]</textcolor>
                <label>$LOCALIZE[31172]</label>
            </control>

            <control type="list" id="52">
                <orientation>horizontal</orientation>
                <animation effect="slide" end="168" condition="Integer.IsEqual(Container(52).NumItems,3)">Conditional</animation>
                <animation effect="slide" end="360" condition="Integer.IsEqual(Container(52).NumItems,2)">Conditional</animation>
                <animation effect="slide" end="516" condition="Integer.IsEqual(Container(52).NumItems,1)">Conditional</animation>
                <top>318</top>
                <left>288</left>
                <width>1344</width>
                <height>390</height>
                <onleft>52</onleft>
                <onright>52</onright>
                <ondown>10035</ondown>
                <onback>ActivateWindow(Home)</onback>
                <scrolltime tween="cubic" easing="out">420</scrolltime>
                <itemlayout height="360" width="312">
                    <control type="group">
                        <animation effect="fade" start="100" end="46" time="0" condition="true">Conditional</animation>
                        <control type="image">
                            <posx>40</posx>
                            <posy>28</posy>
                            <width>232</width>
                            <height>232</height>
                            <texture background="true" fallback="defaultactor.png">$INFO[Listitem.Icon]</texture>
                            <aspectratio align="center" aligny="center" scalediffuse="true">scale</aspectratio>
                        </control>
                        <control type="label">
                            <posx>0</posx>
                            <posy>286</posy>
                            <width>312</width>
                            <height>54</height>
                            <align>center</align>
                            <aligny>center</aligny>
                            <font>Reg30</font>
                            <textcolor fallback="white">$INFO[Skin.String(GeneralTextColor)]</textcolor>
                            <label>$INFO[ListItem.Label]</label>
                        </control>
                    </control>
                </itemlayout>
                <focusedlayout height="360" width="312">
                    <control type="group">
                        <control type="image">
                            <visible>Control.HasFocus(52)</visible>
                            <posx>12</posx>
                            <posy>0</posy>
                            <width>288</width>
                            <height>340</height>
                            <texture border="8" colordiffuse="1AFFFFFF">diffuse/panel-spot.png</texture>
                        </control>
                        <control type="image">
                            <visible>Control.HasFocus(52)</visible>
                            <posx>28</posx>
                            <posy>16</posy>
                            <width>256</width>
                            <height>256</height>
                            <aspectratio align="center" aligny="center" scalediffuse="true">scale</aspectratio>
                            <bordertexture colordiffuse="$INFO[Skin.String(ViewDetailsBorderFocusColor)]">diffuse/panel2.png</bordertexture>
                            <bordersize>4</bordersize>
                            <texture background="true" fallback="defaultactor.png">$INFO[Listitem.Icon]</texture>
                        </control>
                        <control type="image">
                            <visible>!Control.HasFocus(52)</visible>
                            <animation effect="fade" start="100" end="46" time="0" condition="!Control.HasFocus(52)">Conditional</animation>
                            <posx>40</posx>
                            <posy>28</posy>
                            <width>232</width>
                            <height>232</height>
                            <aspectratio align="center" aligny="center" scalediffuse="true">scale</aspectratio>
                            <texture background="true" fallback="defaultactor.png">$INFO[Listitem.Icon]</texture>
                        </control>
                        <control type="label">
                            <posx>0</posx>
                            <posy>286</posy>
                            <width>312</width>
                            <height>54</height>
                            <align>center</align>
                            <aligny>center</aligny>
                            <font>Reg30</font>
                            <textcolor fallback="white">$INFO[Skin.String(GeneralTextColor)]</textcolor>
                            <label>$INFO[ListItem.Label]</label>
                        </control>
                    </control>
                </focusedlayout>
            </control>

            <control type="button" id="10035">
                <posx>804</posx>
                <bottom>228</bottom>
                <width>312</width>
                <height>60</height>
                <onup>52</onup>
                <onback>ActivateWindow(Home)</onback>
                <align>center</align>
                <aligny>center</aligny>
                <font>Reg26</font>
                <textoffsetx>44</textoffsetx>
                <textoffsety>1</textoffsety>
                <label>Manage profiles</label>
                <textcolor>B3FFFFFF</textcolor>
                <focusedcolor>black</focusedcolor>
                <texturefocus border="8" colordiffuse="$INFO[Skin.String(ViewDetailsBorderFocusColor)]">diffuse/panel-spot.png</texturefocus>
                <texturenofocus border="8" colordiffuse="002F2F2F">diffuse/panel-spot.png</texturenofocus>
                <onclick>ActivateWindow(profiles)</onclick>
            </control>
            <control type="image">
                <posx>838</posx>
                <bottom>241</bottom>
                <width>30</width>
                <height>30</height>
                <texture colordiffuse="B3FFFFFF">bingie/edit.png</texture>
            </control>
        </control>
    </controls>
</window>
